---
const links = [
	{
		name: "Послуги",
		href: "/services",
	},
	{
		name: "Проєкти",
		href: "/projects",
	},
	{
		name: "Відгуки",
		href: "/testimonials",
	},
	{
		name: "Про мене",
		href: "/about",
	},
	{
		name: "Контакти",
		href: "/contact",
	},
];
---
<div class="flex flex-wrap items-center justify-center md:justify-start gap-x-6 gap-y-2 text-center">
{
	links.map((link) => (
		<a href={link.href} class="text-sm text-subtle hover:text-text-main transition-colors">
			{link.name}
		</a>
	))
}
</div>